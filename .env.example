# Site URL used for canonical links, sitemap, Open Graph and structured data.
# Change this the day you attach a custom domain (for example https://qalamonline.com).
NEXT_PUBLIC_SITE_URL=https://qalamonline.vercel.app

# Optional: paste the verification codes from Google Search Console / Bing Webmaster Tools.
NEXT_PUBLIC_GSC_VERIFICATION=
NEXT_PUBLIC_BING_VERIFICATION=
